        <mxCell id="4" value="&lt;b&gt;UAV 1&lt;/b&gt;&lt;br&gt;40 m/s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=8;fontColor=#000000;" vertex="1" parent="1">

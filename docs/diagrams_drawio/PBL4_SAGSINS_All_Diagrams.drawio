        <mxCell id="2" value="A. Bản đồ Lưới nhiệt &amp;amp; Điều hướng Trường lực UAV" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#EBF1F8;strokeColor=#2C4A70;swimlaneFillColor=#FFFFFF;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">

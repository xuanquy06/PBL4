        <mxCell id="18" value="&lt;b&gt;4. Trạm Kiểm Lâm cập nhật Tuyến E2E &amp;amp; Dashboard&lt;/b&gt;&lt;br&gt;Hiển thị trạng thái khoanh vùng &amp;amp; luồng gói trên Web" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#000000;" vertex="1" parent="1">

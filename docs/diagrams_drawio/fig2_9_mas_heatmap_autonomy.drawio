        <mxCell id="13" value="&lt;b&gt;1. Điểm cháy mới (UNVERIFIED, risk = 1.0)&lt;/b&gt;&lt;br&gt;Tỏa Gaussian R = 800 m; không bị tự làm mát" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#000000;" vertex="1" parent="1">

            <mxPoint x="189" y="164" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="WebSocket /ws/mophong &amp;amp; REST (:8000)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B365D;fontColor=#1B365D;fontSize=9;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1">

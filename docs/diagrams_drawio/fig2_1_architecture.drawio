<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="diag_2.1_Architecture_3Tier" name="2.1_Architecture_3Tier">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Lớp 3: Giao diện Giám sát &amp;amp; Điều hành Web (Trình duyệt - FastAPI / Leaflet Cục bộ)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="12" width="780" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;Bản đồ Giám sát (/)&lt;/b&gt;&lt;br&gt;7 phân khu Sơn Trà, tuyến E2E, bảng L3, UAV [CLIENT]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="110" y="50" width="340" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;Dashboard HĐH &amp;amp; Mạng (/dashboard)&lt;/b&gt;&lt;br&gt;Packet Sniffer, Mutex net_state_lock, OS Threads, Xuất CSV" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="490" y="50" width="340" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="Lớp 2: Phân tách Mặt phẳng Triển khai (Client - Server) &amp;amp; Lõi Điều phối" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="164" width="900" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Mặt phẳng 1: Client Độc lập&lt;br&gt;(uav_client.py · PID riêng)&lt;/b&gt;&lt;br&gt;• Terminal khác / Máy LAN&lt;br&gt;• Đóng gói 26B + CRC32&lt;br&gt;• TCP (:9000): JOIN, FIRE, LEAVE&lt;br&gt;• UDP (:9001): TELEMETRY 1 Hz" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="206" width="215" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="Tiến trình Server Trạm Kiểm Lâm (main.py · PID chính)" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="202" width="560" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;Lõi Mạng (network_stack &amp;amp; broker)&lt;/b&gt;&lt;br&gt;• Socket thật: TCP :9000 &amp;amp; UDP :9001&lt;br&gt;• TCP ARQ (ACK/Retry) vs UDP CRC32&lt;br&gt;• Định tuyến đa tầng A2G / FANET / LEO&lt;br&gt;• Bảng định tuyến L3 &amp;amp; Packet Sniffer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="355" y="236" width="260" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Lõi Hệ điều hành (os_kernel.py)&lt;/b&gt;&lt;br&gt;• Đa tiến trình Server / Client&lt;br&gt;• Luồng TCP/UDP phục vụ từng Client&lt;br&gt;• Mutex RLock (net_state_lock)&lt;br&gt;• PriorityQueue QoS (P0 &amp;gt; P1 &amp;gt; P2)&lt;br&gt;• Giám sát OS (PID, TID, CPU, RAM)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="628" y="236" width="257" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="Lớp 1: Mặt phẳng Mạng vô tuyến Mô phỏng (Tô-pô SAGSINS / FANET &amp;amp; Địa lý)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="442" width="780" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;39 Tác nhân nội bộ&lt;/b&gt;&lt;br&gt;1 Trạm + 35 UAV + 3 LEO" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="105" y="480" width="225" height="54" as="geometry"/>

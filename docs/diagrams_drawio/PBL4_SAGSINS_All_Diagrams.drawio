        <mxCell id="30" value="&lt;b&gt;CRC32 Checksum (4 Bytes)&lt;/b&gt;&lt;br&gt;zlib.crc32() trên 22B đầu + Payload" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="260" y="240" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="&lt;b&gt;Payload JSON (N Bytes - Biến đổi)&lt;/b&gt;&lt;br&gt;Lệnh, loại tin (t), phân khu (z), tọa độ, pin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="510" y="240" width="330" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="Ghi chú giao vận: Trên TCP gắn thêm tiền tố độ dài 4 Bytes (!I) phía trước gói để cắt khung chính xác;&lt;br&gt;Mỗi bước chuyển tiếp qua UAV trung gian giảm TTL đi 1 (TTL == 0 -&amp;gt; hủy gói TTL_DROP chống lặp)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#000000;align=left;" vertex="1" parent="1">

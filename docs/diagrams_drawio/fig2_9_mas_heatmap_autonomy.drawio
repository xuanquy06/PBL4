        <mxCell id="11" value="&lt;b&gt;Tổng hợp điều hướng: 2.4 × hướng đỉnh + 0.8 × trường lực toàn vùng&lt;/b&gt;&lt;br&gt;Quán tính mượt (30% hướng cũ + 70% hướng mới); trượt dọc biên đa giác" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="35" y="396" width="405" height="66" as="geometry"/>

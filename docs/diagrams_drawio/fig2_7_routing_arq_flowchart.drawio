<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="diag_2.7_Routing_ARQ_Flowchart" name="2.7_Routing_ARQ_Flowchart">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Client gửi gói tin 26B + CRC32" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=10;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="205.0" y="10.0" width="210" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;1. Xác thực Checksum CRC32&lt;/b&gt;&lt;br&gt;Kiểm tra zlib.crc32() trên 22B + Payload&lt;br&gt;Ngay khi Socket Server nhận byte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="185" y="68" width="250" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="CRC32 hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=10;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="230.0" y="134.0" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Hủy gói (CRC32_ERR)&lt;/b&gt;&lt;br&gt;Tăng bộ đếm lỗi CRC32&lt;br&gt;Ghi nhận lên Packet Sniffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF0F0;strokeColor=#8B2635;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="550" y="137" width="225" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="Cự ly tới Trạm&lt;br&gt;d &amp;lt;= 6.000 m?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=10;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="210.0" y="221.0" width="200" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Chọn Kênh 1: GROUND_LINK (A2G)&lt;/b&gt;&lt;br&gt;Truyền thẳng UAV -&amp;gt; SƠN_TRÀ (1 hop)&lt;br&gt;Độ trễ ~0.01 - 0.15 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="550" y="224" width="240" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;2. Đánh giá 3 Vệ tinh LEO (A2S+S2G)&lt;/b&gt;&lt;br&gt;Tìm LEO (&amp;lt;= 2.500 km, PER &amp;lt; 0.25)&lt;br&gt;có SNR thắt cổ chai cao nhất -&amp;gt; LEO / OUT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="185" y="344" width="250" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;3A. Nhánh TCP (:9000)&lt;/b&gt;&lt;br&gt;• Gắn tiền tố 4B (!I) giữ ranh giới khung&lt;br&gt;• JOIN / FIRE_ALERT / LEAVE tin cậy&lt;br&gt;• Đẩy 2 chiều SERVER_CMD xuống Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="434" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;3B. Nhánh UDP (:9001)&lt;/b&gt;&lt;br&gt;• Datagram Telemetry 1 Hz (không ACK)&lt;br&gt;• Kiểm định qua Kênh A2G / LEO&lt;br&gt;• Nếu OUT_OF_RANGE -&amp;gt; RF Drop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="434" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Ghi Packet Sniffer, Mutex RLock &amp;amp; CSV" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=10;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="225.0" y="518.0" width="300" height="36" as="geometry"/>
        </mxCell>

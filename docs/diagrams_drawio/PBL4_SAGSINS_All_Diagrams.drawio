  <diagram id="diag_2.5_Mutex_and_Energy" name="2.5_Mutex_and_Energy">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="A. Đồng bộ đa luồng bằng Mutex (net_state_lock)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="15" y="10" width="445" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;TCP Client&lt;br&gt;Threads&lt;/b&gt;&lt;br&gt;JOIN / FIRE /&lt;br&gt;Ngắt kết nối" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="125" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;UDP Server&lt;br&gt;Thread&lt;/b&gt;&lt;br&gt;Cập nhật vị trí,&lt;br&gt;pin 1 Hz" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="175" y="56" width="125" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;MainThread&lt;br&gt;asyncio&lt;/b&gt;&lt;br&gt;Vòng lặp bay &amp;amp;&lt;br&gt;đẩy WebSocket" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="318" y="56" width="125" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Khóa Mutex RLock (os_kernel.net_state_lock)&lt;/b&gt;&lt;br&gt;Chỉ 1 luồng giữ khóa được phép đọc/ghi đồng thời;&lt;br&gt;Ngăn xung đột bộ nhớ giữa luồng Socket và luồng chính" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="58" y="178" width="360" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Miền găng dùng chung (Critical Section)&lt;/b&gt;&lt;br&gt;• danh_sach_tac_nhan (39 UAV nội bộ &amp;amp; Clients ngoài)&lt;br&gt;• external_clients (phiên TCP theo PID/IP)&lt;br&gt;• packet_sniffer (vòng đệm 40 gói &amp;amp; bộ đếm Wire)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;fontColor=#000000;" vertex="1" parent="1">

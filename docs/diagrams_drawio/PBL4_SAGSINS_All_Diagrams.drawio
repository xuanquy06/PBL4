        <mxCell id="12" value="&lt;b&gt;Kênh vô tuyến giả lập&lt;/b&gt;&lt;br&gt;A2G &amp;lt;= 3.5km | FANET &amp;lt;= 2.8km | LEO" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;fontColor=#000000;" vertex="1" parent="1">

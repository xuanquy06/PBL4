        <mxCell id="5" value="Làm mát R = 600 m&lt;br&gt;(0.35/s -&amp;gt; 0.05)" style="text;html=1;align=center;verticalAlign=center;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="118" y="142" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="HeatNode chưa quét&lt;br&gt;(+0.025/s, trần 0.68)" style="text;html=1;align=center;verticalAlign=center;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=8;fontColor=#8B2635;" vertex="1" parent="1">
          <mxGeometry x="300" y="124" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="Lực hút w_k" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B365D;fontColor=#1B365D;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1">

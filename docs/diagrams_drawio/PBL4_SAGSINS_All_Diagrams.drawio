  <diagram id="diag_2.1_Architecture_3Tier" name="2.1_Architecture_3Tier">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Lớp 3: Hai Giao diện Web Độc lập (Máy 2 Client :8080 &amp;amp; Máy 1 Server :8000)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#EBF1F8;strokeColor=#2C4A70;swimlaneFillColor=#FFFFFF;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="860" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;Máy 2 - Client Fleet UI (:8080)&lt;/b&gt;&lt;br&gt;Quản lý 35 PID, khởi động lại, ngắt UDP &amp;amp; Kill PID" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="258" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;Máy 1 - Bản đồ Giám sát (/)&lt;/b&gt;&lt;br&gt;7 vùng Sơn Trà, Heatmap, kênh A2G/LEO, 35 Clients" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="336" y="50" width="265" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Máy 1 - Dashboard (/dashboard)&lt;/b&gt;&lt;br&gt;Packet Sniffer, 7 Phân khu, Luồng Server OS, CSV" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="619" y="50" width="265" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="Lớp 2: Kiến trúc Client - Server Thuần (Thư mục client/ &amp;amp; server/)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#F4F6F8;strokeColor=#475569;swimlaneFillColor=#FFFFFF;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="164" width="900" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Máy 2: Thư mục client/&lt;br&gt;(100% Python stdlib - Zero pip)&lt;/b&gt;&lt;br&gt;• Quản lý 35 tiến trình OS (PID riêng)&lt;br&gt;• Tự trị trường lực MAS &amp;amp; Ray-Casting&lt;br&gt;• Khung nhị phân 26B + CRC32&lt;br&gt;• TCP :9000 (JOIN, FIRE, LEAVE)&lt;br&gt;• UDP :9001 (Telemetry 1 Hz)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="38" y="204" width="240" height="174" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="Máy 1: Tiến trình Server (server/main.py · Khởi động 0/35 UAV)" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#FFFFFF;strokeColor=#1E293B;swimlaneFillColor=#FFFFFF;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="348" y="202" width="554" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Lõi Mạng (network_stack &amp;amp; broker)&lt;/b&gt;&lt;br&gt;• Socket OS: TCP :9000 &amp;amp; UDP :9001&lt;br&gt;• listen(128) &amp;amp; SO_RCVBUF = 256 KB&lt;br&gt;• Đánh giá 2 kênh A2G / Vệ tinh LEO&lt;br&gt;• Khóa mục tiêu &amp;amp; Handover qua Server&lt;br&gt;• Packet Sniffer lưu lượng TCP/UDP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF1F8;strokeColor=#2C4A70;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="362" y="236" width="260" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;Lõi Hệ điều hành (os_kernel.py)&lt;/b&gt;&lt;br&gt;• Đa luồng phục vụ 35+ kết nối TCP&lt;br&gt;• Khóa loại trừ tương hỗ Mutex (RLock)&lt;br&gt;• PriorityQueue QoS (P0 &amp;gt; P1 &amp;gt; P2)&lt;br&gt;• Phát hiện TCP EOF (Kill/Ctrl+C)&lt;br&gt;• Đo PID, TID, CPU, RAM thời gian thực" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="635" y="236" width="252" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Lớp 1: Môi trường Địa lý Sơn Trà &amp;amp; Quỹ đạo Vũ trụ (Tầng Mặt đất + Không gian)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#F4F6F8;strokeColor=#475569;swimlaneFillColor=#FFFFFF;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="442" width="860" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;Tầng Mặt đất &amp;amp; Dữ liệu&lt;/b&gt;&lt;br&gt;1 Trạm Kiểm Lâm (10.0.0.1)&lt;br&gt;35 slot cấu hình đội bay + CSV QoS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="65" y="480" width="255" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;Tầng Không gian (SGP4)&lt;/b&gt;&lt;br&gt;3 Vệ tinh LEO (10.0.99.1..3)&lt;br&gt;Kênh A2S + S2G &amp;lt;= 2.500 km" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#475569;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="345" y="480" width="255" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Bản đồ 7 vùng Sơn Trà&lt;/b&gt;&lt;br&gt;GeoJSON Z1..Z7 &amp;amp; 210 HeatNode&lt;br&gt;Cảm biến quét R = 600 m" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="625" y="480" width="255" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="Quản lý 35 PID (:8080)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B365D;fontColor=#1B365D;fontSize=9;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">

<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="diag_2.7_Routing_ARQ_Flowchart" name="2.7_Routing_ARQ_Flowchart">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Bắt đầu gửi bản tin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220.0" y="10.0" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;1. Lọc cạnh &amp;amp; Định tuyến Dijkstra&lt;/b&gt;&lt;br&gt;Bỏ PER &amp;gt;= 25%; chọn W_ij nhỏ nhất&lt;br&gt;(A2G -&amp;gt; FANET Mesh -&amp;gt; Vệ tinh LEO)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="185" y="68" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="2. Giảm TTL đi 1 (TTL = TTL - 1)&lt;br&gt;&amp;amp; Cập nhật Bảng định tuyến L3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="195" y="138" width="230" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="TTL == 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="235.0" y="193.0" width="150" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Hủy gói (TTL_DROP)&lt;/b&gt;&lt;br&gt;Chống lặp tuyến vô hạn&lt;br&gt;Ghi nhận vào Sniffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="550" y="199" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;3. Đóng gói 26 Bytes + CRC32&lt;/b&gt;&lt;br&gt;Chèn Seq/Ack, Src/Dst IP, CRC32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="185" y="280" width="250" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="Giao thức?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="230.0" y="339.0" width="160" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;4A. Nhánh TCP (:9000)&lt;/b&gt;&lt;br&gt;• Gửi khung có tiền tố 4B qua Socket TCP&lt;br&gt;• Sai CRC32 -&amp;gt; Gửi lại ARQ (tối đa 3 lần)&lt;br&gt;• Đúng CRC32 -&amp;gt; Nhận ACK (DELIVERED)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="434" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;4B. Nhánh UDP (:9001)&lt;/b&gt;&lt;br&gt;• Gửi datagram qua Socket UDP không ACK&lt;br&gt;• Đúng CRC32 -&amp;gt; Giao tới đích&lt;br&gt;• Sai CRC32 -&amp;gt; Hủy ngay (CRC32_DROP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="434" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Ghi Packet Sniffer &amp;amp; Nhật ký QoS CSV" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230.0" y="518.0" width="290" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1">

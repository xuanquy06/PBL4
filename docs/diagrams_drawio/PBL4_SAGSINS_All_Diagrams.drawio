        </mxCell>
        <mxCell id="21" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B365D;fontColor=#1B365D;fontSize=9;endArrow=block;endFill=1;" edge="1" parent="1">

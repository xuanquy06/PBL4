        <mxCell id="2" value="A. Bản đồ Lưới nhiệt &amp;amp; Điều hướng Trường lực UAV" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">

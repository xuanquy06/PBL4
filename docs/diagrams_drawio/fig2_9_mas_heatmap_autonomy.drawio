        <mxCell id="12" value="B. Chu trình Phản xạ Cháy &amp;amp; Điều phối Bàn giao MAS" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#F4F6F8;strokeColor=#475569;swimlaneFillColor=#FFFFFF;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">

        <mxCell id="8" value="&lt;b&gt;UAV 2&lt;/b&gt;&lt;br&gt;cùng vùng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="238" y="308" width="92" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="Đẩy &amp;lt; 1.200 m&lt;br&gt;+ trượt 0.32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=9;dashed=1;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="246" y="308" as="sourcePoint"/>
            <mxPoint x="195" y="252" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="10" value="Giảm hút c_k = 0.2&lt;br&gt;nếu đồng đội gần hơn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="288" y="234" width="148" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;Tổng hợp điều hướng: 2.4 × hướng đỉnh + 0.8 × trường lực toàn vùng&lt;/b&gt;&lt;br&gt;Quán tính mượt (30% hướng cũ + 70% hướng mới); trượt dọc biên đa giác" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=9;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="35" y="396" width="405" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="B. Chu trình Phản xạ Tự trị MAS &amp;amp; Bàn giao P2P" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="480" y="10" width="445" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;1. Điểm cháy mới (UNVERIFIED, risk = 1.0)&lt;/b&gt;&lt;br&gt;Tỏa Gaussian R = 800 m; không bị tự làm mát" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="525" y="56" width="355" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;2. UAV bay vào bán kính &amp;lt;= 600 m (DETECTED)&lt;/b&gt;&lt;br&gt;Ước lượng lượng pin khứ hồi về Trạm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="525" y="134" width="355" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="3. Pin khứ hồi&lt;br&gt;&amp;gt; 25%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="614.5" y="209.0" width="175" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;Đủ pin (&amp;gt; 25%)&lt;/b&gt;&lt;br&gt;• Khóa mục tiêu (850 m)&lt;br&gt;• Khoanh vùng 130 m&lt;br&gt;• Gửi báo cháy TCP P0&lt;br&gt;  qua Dijkstra về Trạm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="498" y="304" width="192" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;Pin yếu (&amp;lt;= 25%)&lt;/b&gt;&lt;br&gt;• Phát TCP P0 ngang hàng&lt;br&gt;  YEU_CAU_HO_TRO_CHAY_P2P&lt;br&gt;• Đồng đội tiếp quản cháy&lt;br&gt;• Gọi STANDBY &amp;amp; Về sạc" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="714" y="304" width="192" height="92" as="geometry"/>
